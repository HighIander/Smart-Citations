{
  "manifest_version": 3,
  "name": "Smart Citations",
  "version": "2.2.19",
  "description": "Smart Citations provides citation autocomplete, BibTeX management, optional bibliography and PDF synchronization, and Collabtex/Overleaf integration.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "downloads",
    "offscreen",
    "declarativeNetRequestWithHostAccess",
    "clipboardWrite",
    "identity",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "manuscript-links.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Smart Citations bibliography manager"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "collabtex-citation-assistant@smartioz.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "https://api.crossref.org/*",
    "https://api.datacite.org/*",
    "https://api.openalex.org/*",
    "https://orcid.org/*",
    "https://pub.orcid.org/*",
    "https://doi.org/*",
    "https://collabtex.helmholtz.cloud/*",
    "https://overleaf.com/*",
    "https://*.overleaf.com/*",
    "file:///*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pdf-viewer.html",
        "pdf-viewer.css",
        "pdf-viewer.js",
        "attachments.js",
        "pdf-lib/pdf-lib.min.js",
        "pdfjs/pdf.mjs",
        "pdfjs/pdf.worker.mjs",
        "pdfjs/pdf_viewer.mjs",
        "pdfjs/pdf_viewer.css",
        "pdfjs/images/*"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
